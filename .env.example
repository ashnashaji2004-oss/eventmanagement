# Django Backend Environment Configuration
SECRET_KEY=django-insecure-schoolfest-production-secret-key-change-this-in-prod
DEBUG=True
ALLOWED_HOSTS=*

# Database: 'sqlite' for zero-config local, or 'postgresql' for PostgreSQL
DB_ENGINE=sqlite
DB_NAME=schoolfest_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Timezone & School Default
TIME_ZONE=Asia/Kolkata
VITE_API_BASE_URL=http://localhost:8000/api
